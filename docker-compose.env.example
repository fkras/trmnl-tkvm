# Copy values from this file into .env, or pass it with:
# docker compose --env-file docker-compose.env up -d --build

# Use 0.0.0.0 to expose on every local interface, or set this to a LAN IP
# that is assigned to this machine, for example 192.168.1.50.
BIND_IP=0.0.0.0

# Host port used on the local network.
HOST_PORT=3000

# Host port used for the TRMNL PNG renderer.
RENDERER_HOST_PORT=3101

# Internal URL rendered by the renderer service.
TRMNL_TARGET_URL=http://takvimi:3000/trmnl

# Short PNG cache window in milliseconds.
TRMNL_CACHE_TTL_MS=60000

# Time zone used by the container.
TZ=Europe/Belgrade
